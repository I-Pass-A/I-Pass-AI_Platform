# Supabase public settings (accessible in client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase secret service key (SERVER-SIDE ONLY, do not expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini API key for AI Tutor and Exam Prep (Free tier from Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key